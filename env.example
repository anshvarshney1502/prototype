# ElevenLabs: Agents, Agent Testing, TTS, Scribe STT, voices (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Gemini: job card drafting, Coach rules, refine, call summaries (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# LLM the voice agents run on inside ElevenLabs
AGENT_LLM=gemini-3.5-flash
# MongoDB Atlas connection string (Atlas → HACKTOBERFEST → Connect → Drivers)
MONGODB_URI=
MONGODB_DB=munshi
# Random string; ElevenLabs sends it to the booking tools so nobody else can call them
TOOL_SECRET=
# Public URL ElevenLabs calls for tools (your Render URL, e.g. https://munshi.onrender.com)
PUBLIC_BASE_URL=
# Optional: post-call webhook signing secret from ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
